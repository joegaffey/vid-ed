{
  "name": "vided",
  "version": "0.1.0",
  "description": "Agentic video editor toolset: analyse media, compose an edit, render voice-over + captions.",
  "type": "module",
  "bin": {
    "vided": "./bin/vided"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:studio": "node scripts/build-studio.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepare": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
